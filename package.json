{
  "name": "pianora",
  "version": "0.1.0",
  "description": "Pianora — Turn sheet music into living grand piano performances, 100% locally in the browser.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "setup:performance-models": "node scripts/performance-models/restore.mjs",
    "setup:packs": "node scripts/prepare-asset-packs.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "setup:runtime": "node scripts/setup-runtime.mjs",
    "setup:soundfonts": "node scripts/download-soundfonts.mjs",
    "deploy": "npm run build && node scripts/deploy-accounts.mjs"
  },
  "dependencies": {
    "@clerk/localizations": "^4.28.0",
    "@clerk/react": "^6.19.7",
    "@sightread/lilypond-wasm": "^0.2.0",
    "@tonejs/midi": "^2.0.28",
    "jose": "^6.2.18",
    "lucide-react": "^1.82.0",
    "onnxruntime-web": "^1.21.0",
    "opensheetmusicdisplay": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "spessasynth_lib": "^4.4.10",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "wrangler": "^4.169.0"
  }
}
