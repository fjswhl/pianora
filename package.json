{
  "name": "pianora",
  "version": "0.1.0",
  "description": "Pianora — Turn sheet music into living grand piano performances, 100% locally in the browser.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
