    "lucide-react": "^1.82.0",
    "onnxruntime-web": "^1.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "spessasynth_lib": "^4.4.10",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
