{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pianora",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "opuslin.uk", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Large binaries are served from R2 through the Worker (with Range support)
    "run_worker_first": ["/presets/*", "/p/*", "/api/*", "/soundfonts/*", "/models/*", "/ort/*"]
  },
  "d1_databases": [{
    "binding": "CATALOG",
    "database_name": "pianora-catalog",
    "database_id": "bbc25515-238e-47af-af76-17a529a9aacc",
    "migrations_dir": "catalog/migrations"
  }],
  "r2_buckets": [
    {
      "binding": "BIG_FILES",
      "bucket_name": "pianora-assets"
    }
  ]
}
